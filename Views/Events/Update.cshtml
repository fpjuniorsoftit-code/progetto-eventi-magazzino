@model GestionEventiMagazzino.ViewModels.EventoCreateViewModel

@{
    ViewData["Title"] = "Modifica evento";
    Layout = null; // Pagina autonoma senza layout condiviso
}

<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modifica evento - Gestione Eventi Magazzino</title>

    <!-- Foglio di stile locale di Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Palette verde e bianco coerente con il resto dell'applicazione */
            :root {
                --verde-principale: #0e6b47;
                --verde-scuro: #084c32;
                --verde-sfondo: #eaf2ec;
                --verde-bordo-basso: #0e6b47;
                --bordo-card: #cfe0d5;
            }

            /* Layout a colonna per tenere il footer in fondo */
            body.update-page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                background-color: var(--verde-sfondo);
                border-bottom: 8px solid var(--verde-bordo-basso);
            }

            /* Fascia superiore verde */
            .top-header-bar {
                background-color: var(--verde-principale);
                color: #ffffff;
                padding: 0.75rem 1rem;
                border-bottom: 3px solid var(--verde-scuro);
                flex-shrink: 0;
            }

            .top-header-title {
                font-size: 1rem;
                font-weight: 700;
                letter-spacing: 0.3px;
                margin: 0;
            }

            /* Card ampia e bilanciata per il form di modifica */
            .update-card {
                width: 100%;
                max-width: 720px;
                padding: 32px;
                background-color: #ffffff;
                border: 1px solid var(--bordo-card);
                border-radius: 10px;
                border-top: 4px solid var(--verde-principale);
                box-shadow: 0 6px 20px rgba(8, 76, 50, 0.08);
            }

            .update-title {
                text-align: center;
                margin-bottom: 24px;
            }

                .update-title h2 {
                    color: var(--verde-scuro);
                    font-weight: 700;
                    margin-bottom: 0;
                }

            .form-label {
                font-weight: 600;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--verde-principale);
                box-shadow: 0 0 0 0.2rem rgba(14, 107, 71, 0.18);
            }

            /* Pulsante principale di salvataggio */
            .btn-update {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
                color: #ffffff;
                font-weight: 600;
                padding: 8px 18px;
            }

                .btn-update:hover,
                .btn-update:focus {
                    background-color: var(--verde-scuro);
                    border-color: var(--verde-scuro);
                    color: #ffffff;
                }
    </style>
</head>
<body class="update-page">

    <!-- Fascia superiore verde a larghezza piena -->
    <header class="top-header-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="top-header-title">Gestione Eventi Magazzino — Modifica evento</span>
        </div>
    </header>

    <main class="d-flex flex-column flex-grow-1 justify-content-center align-items-center px-3 py-4">

        <div class="update-card">
            <div class="update-title">
                <h2>Modifica evento</h2>
            </div>

            <!-- Invia i dati modificati all'azione Update del controller Events -->
            <form asp-controller="Events" asp-action="Update" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            

                <!-- Operatore assegnatario con ricerca live collegata allo script -->
                <div class="mb-3">
                    <label class="form-label" for="ricercaUtente">Operatore assegnatario</label>
                    <div class="position-relative">
                        <!-- Precompilato con lo username già assegnato all'evento -->
                        <input type="text"
                               id="ricercaUtente"
                               class="form-control"
                               value="@Model?.Username"
                               placeholder="Cerca operatore..."
                               autocomplete="off" />

                        <!-- Contenitore dei suggerimenti restituiti dal server -->
                        <div id="risultatiRicerca"
                             class="list-group position-absolute w-100 shadow-sm"
                             style="z-index: 200; display: none;">
                        </div>
                    </div>

                    <!-- Campo nascosto collegato al modello per il POST -->
                    <input type="hidden" asp-for="Username" id="usernameRicerca" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <!-- Altri operatori coinvolti -->
                <div class="mb-3">
                    <label asp-for="AltriOperatori" class="form-label"></label>
                    <input asp-for="AltriOperatori" class="form-control" />
                    <span asp-validation-for="AltriOperatori" class="text-danger"></span>
                </div>

                <!-- Pianificazione temporale: data, ora inizio e ora fine -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DataEvento" class="form-label"></label>
                        <input asp-for="DataEvento" type="date" class="form-control" />
                        <span asp-validation-for="DataEvento" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OraInizio" class="form-label"></label>
                        <input asp-for="OraInizio" type="time" class="form-control" />
                        <span asp-validation-for="OraInizio" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OraFine" class="form-label"></label>
                        <input asp-for="OraFine" type="time" class="form-control" />
                        <span asp-validation-for="OraFine" class="text-danger"></span>
                    </div>
                </div>

                <!-- Descrizione dell'evento -->
                <div class="mb-3">
                    <label asp-for="Evento" class="form-label"></label>
                    <textarea asp-for="Evento" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Evento" class="text-danger"></span>
                </div>

                <!-- Note interne e stato affiancati -->
                <div class="row">
                    <div class="col-md-7 mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note"
                               class="form-control"
                               placeholder="note visibili solo sul db" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="col-md-5 mb-4">
                        <label asp-for="Stato" class="form-label"></label>
                        <select asp-for="Stato" asp-items="ViewBag.Stati" class="form-select">
                            <option value="">Seleziona uno stato</option>
                        </select>
                        <span asp-validation-for="Stato" class="text-danger"></span>
                    </div>
                </div>

                <!-- Azioni di annullamento e salvataggio -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Annulla
                    </a>

                    <button type="submit" class="btn btn-update">
                        Salva modifiche
                    </button>
                </div>

            </form>
        </div>

        <!-- Logo JUNIORSOFT posizionato sotto la card -->
        <footer class="text-center pb-3 mt-4">
            <img src="~/images/logoJR.png"
                 alt="Logo JUNIORSOFT"
                 class="img-fluid"
                 style="max-width: 260px; height: auto;" />
        </footer>

    </main>

    <!-- Ordine richiesto: jQuery -> jQuery Validate -> Unobtrusive Validation -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Ricerca asincrona dell'operatore a partire da almeno 2 caratteri -->
    <script>
            function inizializzaRicerca(inputId, risultatiId, usernameId) {
                const input = document.getElementById(inputId);
                const risultati = document.getElementById(risultatiId);
                const username = document.getElementById(usernameId);

                // Esce se manca un elemento necessario
                if (!input || !risultati || !username) {
                    return;
                }

                let timeout;

                input.addEventListener("input", function () {
                    // Annulla l'eventuale ricerca ancora in attesa
                    clearTimeout(timeout);

                    // Azzera l'operatore selezionato se il testo cambia
                    username.value = "";
                    risultati.innerHTML = "";
                    risultati.style.display = "none";

                    const termine = input.value.trim();

                    // Avvia la ricerca solo da 2 caratteri in su
                    if (termine.length < 2) {
                        return;
                    }

                    // Attende 250 ms dall'ultima digitazione prima di interrogare il server
                    timeout = setTimeout(async function () {
                        try {
                            const urlRicerca = '@Url.Action("Search", "Users")';

                            // Richiede al server gli username corrispondenti
                            const response = await fetch(
                                `${urlRicerca}?term=${encodeURIComponent(termine)}`
                            );

                            if (!response.ok) {
                                throw new Error("Errore durante la ricerca.");
                            }

                            const utenti = await response.json();

                            // Ignora la risposta se nel frattempo il testo è cambiato
                            if (input.value.trim() !== termine) {
                                return;
                            }

                            risultati.innerHTML = "";

                            if (!Array.isArray(utenti) || utenti.length === 0) {
                                risultati.style.display = "none";
                                return;
                            }

                            // Crea un suggerimento cliccabile per ogni username trovato
                            utenti.forEach(function (utente) {
                                const elemento = document.createElement("button");
                                elemento.type = "button";
                                elemento.className = "list-group-item list-group-item-action";
                                elemento.textContent = utente;

                                // Seleziona l'operatore e valorizza il campo inviato dal form
                                elemento.addEventListener("click", function () {
                                    input.value = utente;
                                    username.value = utente;
                                    risultati.style.display = "none";
                                });

                                risultati.appendChild(elemento);
                            });

                            risultati.style.display = "block";
                        } catch (errore) {
                            console.error(errore);
                            risultati.innerHTML = "";
                            risultati.style.display = "none";
                        }
                    }, 250);
                });
            }

            // Attiva la ricerca nella pagina di modifica evento
            inizializzaRicerca(
                "ricercaUtente",
                "risultatiRicerca",
                "usernameRicerca"
            );
    </script>

</body>
</html>