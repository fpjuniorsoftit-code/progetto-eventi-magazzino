@model GestionEventiMagazzino.ViewModels.EventoCreateViewModel

@{
    ViewData["Title"] = "Modifica evento";
    Layout = null; // Pagina autonoma senza layout condiviso
}

<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modifica evento - Gestione Eventi Magazzino</title>

    <!-- Foglio di stile locale di Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Palette ispirata al sito */
            :root {
                --verde-principale: #0e6b47;
                --verde-scuro: #084c32;
                --verde-sfondo: #eaf2ec;
                --verde-bordo-basso: #0e6b47;
                --bordo-card: #cfe0d5;
            }

            /* Layout a colonna per tenere il footer in fondo senza creare scorrimenti superflui */
            body.update-page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                background-color: var(--verde-sfondo);
                border-bottom: 8px solid var(--verde-bordo-basso);
            }

            /* Fascia superiore verde coerente con il tema */
            .top-header-bar {
                background-color: var(--verde-principale);
                color: #ffffff;
                padding: 0.75rem 1rem;
                border-bottom: 3px solid var(--verde-scuro);
                flex-shrink: 0;
            }

            .top-header-title {
                font-size: 1rem;
                font-weight: 700;
                letter-spacing: 0.3px;
                margin: 0;
            }

            /* Card ampia e bilanciata per evitare un form troppo stretto e alto */
            .update-card {
                width: 100%;
                max-width: 720px;
                padding: 32px;
                background-color: #fff;
                border: 1px solid var(--bordo-card);
                border-radius: 10px;
                border-top: 4px solid var(--verde-principale);
                box-shadow: 0 6px 20px rgba(8, 76, 50, 0.08);
            }

            .update-title {
                text-align: center;
                margin-bottom: 24px;
            }

                .update-title h2 {
                    color: var(--verde-scuro);
                    font-weight: 700;
                    margin-bottom: 0;
                }

            .form-label {
                font-weight: 600;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--verde-principale);
                box-shadow: 0 0 0 0.2rem rgba(14, 107, 71, 0.18);
            }

            /* Pulsante principale di salvataggio */
            .btn-update {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
                color: #ffffff;
                font-weight: 600;
                padding: 8px 18px;
            }

                .btn-update:hover,
                .btn-update:focus {
                    background-color: var(--verde-scuro);
                    border-color: var(--verde-scuro);
                    color: #ffffff;
                }
    </style>
</head>
<body class="update-page">

    <!-- Fascia superiore verde a larghezza piena -->
    <header class="top-header-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="top-header-title">Gestione Eventi Magazzino — Modifica evento</span>
        </div>
    </header>

    <main class="d-flex flex-column flex-grow-1 justify-content-center align-items-center px-3 py-4">

        <div class="update-card">
            <div class="update-title">
                <h2>Modifica evento</h2>
            </div>

            <!-- Richiama il metodo Update che c'è dentro il controller -->
            <form asp-action="Update" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Assegnatario e altri operatori affiancati da schermo medio in su -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <select asp-for="Username" asp-items="ViewBag.Utenti" class="form-select">
                            <option value="">Seleziona un assegnatario</option>
                        </select>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AltriOperatori" class="form-label"></label>
                        <input asp-for="AltriOperatori" class="form-control" />
                        <span asp-validation-for="AltriOperatori" class="text-danger"></span>
                    </div>
                </div>

                <!-- Pianificazione temporale: data, ora inizio e ora fine -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DataEvento" class="form-label"></label>
                        <input asp-for="DataEvento" type="date" class="form-control" />
                        <span asp-validation-for="DataEvento" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OraInizio" class="form-label"></label>
                        <input asp-for="OraInizio" type="time" class="form-control" />
                        <span asp-validation-for="OraInizio" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OraFine" class="form-label"></label>
                        <input asp-for="OraFine" type="time" class="form-control" />
                        <span asp-validation-for="OraFine" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Evento" class="form-label"></label>
                    <textarea asp-for="Evento" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Evento" class="text-danger"></span>
                </div>

                <!-- Note interne e stato affiancati -->
                <div class="row">
                    <div class="col-md-7 mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note"
                               class="form-control"
                               placeholder="note visibili solo sul db" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="col-md-5 mb-4">
                        <label asp-for="Stato" class="form-label"></label>
                        <select asp-for="Stato" asp-items="ViewBag.Stati" class="form-select">
                            <option value="">Seleziona uno stato</option>
                        </select>
                        <span asp-validation-for="Stato" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        Annulla
                    </a>

                    <button type="submit" class="btn btn-update">
                        Salva modifiche
                    </button>
                </div>

            </form>
        </div>

        <!-- Logo JUNIORSOFT posizionato sotto la card -->
        <footer class="text-center pb-3 mt-4">
            <img src="~/images/sfondoJRgreen.jpeg"
                 alt="Logo JUNIORSOFT"
                 class="img-fluid"
                 style="max-width: 260px; height: auto;" />
        </footer>

    </main>

    <!-- Ordine richiesto: jQuery -> jQuery Validate -> Unobtrusive Validation -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>