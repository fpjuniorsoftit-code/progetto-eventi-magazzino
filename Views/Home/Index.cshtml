@model List<GestionEventiMagazzino.Models.EventoMagazzino>

@{
    ViewData["Title"] = "Home";
    Layout = null; // Pagina autonoma senza layout condiviso
    var totalePagineIniziale = Math.Max(1, ViewBag.TotalPages as int? ?? 1);
    var paginaIniziale = Math.Max(1, ViewBag.CurrentPage as int? ?? 1);
}

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestione Eventi Magazzino</title>
    <!-- Collegamento al file CSS personalizzato -->
    <link rel="stylesheet" href="~/css/personalizzazione.css" />
    <!-- Bootstrap CSS locale: compatibile con rete aziendale offline -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Palette verde e bianco coerente con il resto dell'applicazione */
            :root {
                --verde-principale: #0e6b47;
                --verde-scuro: #084c32;
                --verde-sfondo: #eaf2ec;
                --bordo-card: #cfe0d5;
                --verde-bordo-basso: #6ca83b;
            }

            /* Struttura a colonna: mantiene il footer in basso sia con pochi che con molti eventi */
            body.dashboard-page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                background-color: var(--verde-sfondo);
                border-bottom: 8px solid var(--verde-bordo-basso);
            }

            /* Fascia superiore verde ad alto contrasto */
            .top-header-bar {
                background-color: var(--verde-principale);
                color: #ffffff;
                padding: 0.75rem 1.5rem;
                border-bottom: 3px solid var(--verde-scuro);
                flex-shrink: 0;
            }

            .top-header-title {
                font-size: 1.05rem;
                font-weight: 700;
                letter-spacing: 0.3px;
                margin: 0;
            }

            /* Card contenitore della tabella eventi */
            .dashboard-card {
                background-color: #ffffff;
                border: 1px solid var(--bordo-card);
                border-top: 4px solid var(--verde-principale);
                border-radius: 10px;
                box-shadow: 0 6px 20px rgba(8, 76, 50, 0.08);
                overflow: hidden;
            }

            .dashboard-card-header {
                background-color: #f4f9f5;
                border-bottom: 1px solid var(--bordo-card);
                padding: 1rem 1.25rem;
            }

            .dashboard-subtitle {
                color: var(--verde-scuro);
                font-weight: 700;
            }

            /* Badge indicatore paginazione "1 / N" */
            .indicatore-paginazione {
                background-color: #ffffff;
                color: var(--verde-scuro);
                border: 1px solid var(--bordo-card);
                font-weight: 700;
                font-size: 0.85rem;
                padding: 0.3rem 0.65rem;
                border-radius: 6px;
            }

            /* Intestazione tabella in verde scuro con testo bianco */
            .table-eventi thead th {
                background-color: var(--verde-scuro);
                color: #ffffff;
                border-bottom: 2px solid var(--verde-principale);
                font-weight: 600;
                white-space: nowrap;
                vertical-align: middle;
            }

            /* Pulsante filtro non attivo: sfondo chiaro e icona verde ben leggibile */
            .btn-filtro-inattivo {
                background-color: #ffffff;
                color: var(--verde-scuro);
                border: 1px solid #b7d1c1;
                padding: 0.2rem 0.45rem;
                line-height: 1;
            }

                .btn-filtro-inattivo:hover,
                .btn-filtro-inattivo:focus {
                    background-color: #e6f2eb;
                    color: var(--verde-scuro);
                    border-color: var(--verde-principale);
                }

            /* Pulsante principale verde */
            .btn-verde {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
                color: #ffffff;
                font-weight: 600;
            }

                .btn-verde:hover,
                .btn-verde:focus {
                    background-color: var(--verde-scuro);
                    border-color: var(--verde-scuro);
                    color: #ffffff;
                }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--verde-principale);
                box-shadow: 0 0 0 0.2rem rgba(14, 107, 71, 0.18);
            }

            /* Intestazione verde per i modali di filtro */
            .modal-header-verde {
                background-color: var(--verde-principale);
                color: #ffffff;
            }
    </style>
</head>

<body class="dashboard-page">

    <!-- Barra superiore verde con titolo e azioni principali -->
    <header class="top-header-bar">
        <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="top-header-title">Gestione Eventi Magazzino</span>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Navigazione verso la creazione di un nuovo evento -->
                <a asp-controller="Events" asp-action="Create" class="btn btn-sm btn-light fw-semibold">
                    Creazione nuovi eventi
                </a>

                <!-- Navigazione verso il pannello amministratore -->
                <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-light">
                    Pannello admin
                </a>

                <!-- Logout in POST per chiudere la sessione -->
                <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- Contenuto principale con flex-grow-1 per ancorare il footer in fondo -->
    <main class="container-fluid flex-grow-1 py-4">

        <div class="dashboard-card">
            <div class="dashboard-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="dashboard-subtitle mb-0">
                    Eventi (incluso ieri, oggi e 5 giorni in avanti)
                </h5>

                <div class="d-flex align-items-center gap-2">
                    <!-- Indicatore pagina corrente / totale pagine (es. "1 / 4") -->
                    <span id="indicatorePagina"
                          class="indicatore-paginazione"
                          title="Paginazione automatica eventi">
                        @paginaIniziale / @totalePagineIniziale
                    </span>

                    <!-- Pulsante rapido per azzerare i filtri attivi -->
                    @if (ViewBag.DataFiltro != null || ViewBag.StatoFiltro != null || ViewBag.UsernameFiltro != null)
                    {
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            Rimuovi filtri attivi
                        </a>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 table-eventi">
                    <thead>
                        <tr>
                            <th>Evento</th>

                            <th>
                                Data evento
                                <!-- Filtro data: evidenziato in giallo se attivo -->
                                <button type="button"
                                        class="btn btn-sm ms-1 @(ViewBag.DataFiltro != null ? "btn-warning text-dark fw-semibold" : "btn-filtro-inattivo")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#filtroData"
                                        title="Filtra per data">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" />
                                    </svg>
                                </button>
                            </th>

                            <th>Ora inizio</th>

                            <th>Ora fine</th>

                            <th>
                                Stato
                                <!-- Filtro stato: evidenziato in giallo se attivo -->
                                <button type="button"
                                        class="btn btn-sm ms-1 @(ViewBag.StatoFiltro != null ? "btn-warning text-dark fw-semibold" : "btn-filtro-inattivo")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#filtroStato"
                                        title="Filtra per stato">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" />
                                    </svg>
                                </button>
                            </th>

                            <th class="text-center">
                                Operatore assegnatario
                                <!-- Filtro operatore: evidenziato in giallo se attivo -->
                                <button type="button"
                                        class="btn btn-sm ms-1 @(ViewBag.UsernameFiltro != null ? "btn-warning text-dark fw-semibold" : "btn-filtro-inattivo")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#filtroUsername"
                                        title="Filtra per operatore">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5z" />
                                    </svg>
                                </button>
                            </th>

                            <th>Persone coinvolte</th>

                            @if (User.IsInRole("Admin"))
                            {
                                <th>Azioni</th>
                            }
                        </tr>
                    </thead>

                    <!-- Righe caricate tramite partial view e aggiornate da SignalR e paginazione automatica -->
                    @await Html.PartialAsync("_RigheEventi", Model)
                </table>
            </div>
        </div>

    </main>

    <!-- Logo JUNIORSOFT ancorato a fine pagina -->
    <footer class="text-center py-3 mt-auto">
        <img src="~/images/logoJR.png"
             alt="Logo JUNIORSOFT"
             class="img-fluid"
             style="max-width: 260px; height: auto;" />
    </footer>


    <!-- ====================================================== -->
    <!-- MODALE FILTRO DATA                                     -->
    <!-- ====================================================== -->
    <div class="modal fade" id="filtroData" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Home" asp-action="Index" method="get">
                    <!-- Preserva gli altri filtri già impostati -->
                    <input type="hidden" name="username" value="@ViewBag.UsernameFiltro" />
                    <input type="hidden" name="stato" value="@ViewBag.StatoFiltro" />

                    <div class="modal-header modal-header-verde">
                        <h5 class="modal-title">Filtra eventi per data</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <label class="form-label fw-semibold">Seleziona una data</label>
                        <input type="date"
                               name="data"
                               class="form-control"
                               value="@ViewBag.DataFiltro"
                               required />
                    </div>

                    <div class="modal-footer">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Rimuovi filtro
                        </a>
                        <button type="submit" class="btn btn-verde">
                            Applica filtro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- ====================================================== -->
    <!-- MODALE FILTRO STATO                                    -->
    <!-- ====================================================== -->
    <div class="modal fade" id="filtroStato" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Home" asp-action="Index" method="get">
                    <!-- Preserva gli altri filtri già impostati -->
                    <input type="hidden" name="data" value="@ViewBag.DataFiltro" />
                    <input type="hidden" name="username" value="@ViewBag.UsernameFiltro" />

                    <div class="modal-header modal-header-verde">
                        <h5 class="modal-title">Filtra eventi per stato</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <label class="form-label fw-semibold">Seleziona uno stato</label>
                        <select name="stato" class="form-select" required>
                            <option value="">Seleziona uno stato</option>
                            <option value="IN CORSO" selected="@(ViewBag.StatoFiltro?.ToString() == "IN CORSO")">
                                In corso
                            </option>
                            <option value="SOSPESO" selected="@(ViewBag.StatoFiltro?.ToString() == "SOSPESO")">
                                Sospeso
                            </option>
                            <option value="CANCELLATO" selected="@(ViewBag.StatoFiltro?.ToString() == "CANCELLATO")">
                                Annullato
                            </option>
                            <option value="CHIUSO" selected="@(ViewBag.StatoFiltro?.ToString() == "CHIUSO")">
                                Chiuso
                            </option>
                        </select>
                    </div>

                    <div class="modal-footer">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Rimuovi filtro
                        </a>
                        <button type="submit" class="btn btn-verde">
                            Applica filtro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- ====================================================== -->
    <!-- MODALE FILTRO OPERATORE                                -->
    <!-- ====================================================== -->
    <div class="modal fade" id="filtroUsername" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Home" asp-action="Index" method="get">
                    <!-- Preserva gli altri filtri già impostati -->
                    <input type="hidden" name="data" value="@ViewBag.DataFiltro" />
                    <input type="hidden" name="stato" value="@ViewBag.StatoFiltro" />

                    <div class="modal-header modal-header-verde">
                        <h5 class="modal-title">Filtra eventi per operatore</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <label class="form-label fw-semibold">Seleziona uno username</label>
                        <select name="username" class="form-select" required>
                            <option value="">Seleziona un operatore</option>
                            @foreach (var utente in ViewBag.Utenti)
                            {
                                <option value="@utente" selected="@(ViewBag.UsernameFiltro?.ToString() == utente)">
                                    @utente
                                </option>
                            }
                        </select>
                    </div>

                    <div class="modal-footer">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Rimuovi filtro
                        </a>
                        <button type="submit" class="btn btn-verde">
                            Applica filtro
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <!-- Libreria SignalR locale per l'aggiornamento in tempo reale -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <!-- Bootstrap Bundle JS locale (include Popper per i modali) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            // Gestisce la paginazione "1 / N" con rotazione automatica a timer.
            // Se c'è o rimane una sola pagina, la rotazione non parte o si ferma.
            function gestisciPaginazioneAuto({
                contenitoreRigheId,          // id dell'elemento HTML dove inserire le righe
                indicatoreId,                // id dell'elemento HTML dove scrivere "1 / N"
                urlBase,                     // URL del server (preserva eventuali filtri attivi)
                paginaIniziale = 1,          // pagina da cui partire
                totalePagineIniziale = 1,    // quante pagine ci sono all'inizio
                intervalloMs = 10000         // ogni quanti millisecondi cambiare pagina (10000 = 10 secondi)
            }) {
                const contenitore = document.getElementById(contenitoreRigheId);
                const indicatore = document.getElementById(indicatoreId);

                if (!contenitore || !urlBase) {
                    return null;
                }

                let paginaCorrente = Math.max(1, paginaIniziale);
                let totalePagine = Math.max(1, totalePagineIniziale);
                let timer = null;
                let caricamentoInCorso = false;

                // Scrive "pagina corrente / totale" (es. "2 / 4") nell'indicatore
                function aggiornaIndicatore() {
                    if (indicatore) {
                        indicatore.textContent = `${paginaCorrente} / ${totalePagine}`;
                    }
                }

                // Ferma il timer, se è attivo
                function fermaTimer() {
                    if (timer !== null) {
                        clearInterval(timer);
                        timer = null;
                    }
                }

                // Avvia il timer di rotazione solo se ci sono almeno 2 pagine
                function avviaTimerSeNecessario() {
                    fermaTimer();

                    if (totalePagine <= 1) {
                        return;
                    }

                    timer = setInterval(() => {
                        if (totalePagine <= 1) {
                            fermaTimer();
                            return;
                        }

                        const prossimaPagina = paginaCorrente >= totalePagine ? 1 : paginaCorrente + 1;
                        caricaPagina(prossimaPagina);
                    }, intervalloMs);
                }

                // Aggiunge o aggiorna il parametro ?page=N mantenendo eventuali filtri già presenti nell'URL
                function costruisciUrlPagina(numeroPagina) {
                    const url = new URL(urlBase, window.location.origin);
                    url.searchParams.set("page", String(numeroPagina));
                    return url.toString();
                }

                // Scarica dal server le righe della pagina richiesta e aggiorna tabella e stato
                async function caricaPagina(numeroPagina) {
                    if (caricamentoInCorso) {
                        return;
                    }

                    caricamentoInCorso = true;

                    try {
                        const response = await fetch(costruisciUrlPagina(numeroPagina), {
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });

                        if (!response.ok) {
                            return;
                        }

                        const html = await response.text();

                        // Estrae le righe e l'attributo data-total-pages dal <tbody> restituito dalla partial view
                        const tempTable = document.createElement("table");
                        tempTable.innerHTML = html.trim();
                        const nuovoTbody = tempTable.querySelector("tbody");

                        let nuovoTotale = totalePagine;

                        if (nuovoTbody) {
                            nuovoTotale = Math.max(1, parseInt(nuovoTbody.dataset.totalPages || "1", 10) || 1);
                            contenitore.innerHTML = nuovoTbody.innerHTML;
                            contenitore.dataset.totalPages = String(nuovoTotale);
                            contenitore.dataset.currentPage = String(numeroPagina);
                        } else {
                            contenitore.innerHTML = html;
                            nuovoTotale = Math.max(1, parseInt(contenitore.dataset.totalPages || "1", 10) || 1);
                        }

                        totalePagine = nuovoTotale;

                        // Se il totale delle pagine è diminuito e la pagina corrente non esiste più, riparte da 1
                        if (numeroPagina > totalePagine) {
                            caricamentoInCorso = false;
                            paginaCorrente = 1;
                            return caricaPagina(1);
                        }

                        paginaCorrente = numeroPagina;
                        aggiornaIndicatore();
                        avviaTimerSeNecessario();
                    } catch (errore) {
                        console.error("Errore nel caricamento della pagina:", errore);
                    } finally {
                        caricamentoInCorso = false;
                    }
                }

                // Avvio iniziale
                aggiornaIndicatore();
                avviaTimerSeNecessario();

                return {
                    // Ricarica la pagina corrente (usato da SignalR e dal controllo temporale ogni 60s)
                    ricaricaDaSignalR: () => caricaPagina(paginaCorrente),
                    ferma: fermaTimer
                };
            }

            // Inizializza la paginazione automatica sulla Dashboard
            const paginazione = gestisciPaginazioneAuto({
                contenitoreRigheId: "righeEventi",
                indicatoreId: "indicatorePagina",
                urlBase: window.location.href,
                paginaIniziale: @paginaIniziale,
                totalePagineIniziale: @totalePagineIniziale,
                intervalloMs: 10000
            });

            // Ricarica la pagina corrente mantenendo filtri e stato della paginazione
            async function aggiornaEventi() {
                if (paginazione) {
                    await paginazione.ricaricaDaSignalR();
                }
            }

            // Connessione all'Hub SignalR
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/eventiHub")
                .build();

            // Aggiorna la tabella quando il server notifica una modifica agli eventi
            connection.on("AggiornaEventi", aggiornaEventi);

            connection.start()
                .then(() => console.log("Connessione SignalR stabilita!"))
                .catch(err => console.error("Errore di connessione", err));

            // Aggiornamento periodico ogni 60 secondi per riallineare i colori temporali delle righe (ritardo / imminente)
            setInterval(() => {
                aggiornaEventi()
                    .catch(err => console.error("Errore aggiornamento automatico", err));
            }, 60000);
    </script>

</body>
</html>