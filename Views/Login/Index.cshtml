@model GestionEventiMagazzino.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Accesso";
    Layout = null; // Pagina autonoma senza layout condiviso
}

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accesso - Gestione Eventi Magazzino</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Palette verde corporativa */
            :root {
                --verde-principale: #0e6b47;
                --verde-scuro: #084c32;
                --verde-sfondo: #eaf2ec;
                --bordo-card: #cfe0d5;
            }

            /* Layout flessibile a colonna: evita lo scroll verticale causato dalla barra superiore */
            body.login-page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                background-color: var(--verde-sfondo);
                border-bottom: 8px solid var(--verde-principale);
            }

            /* Fascia decorativa superiore */
            .top-accent-bar {
                height: 6px;
                background-color: var(--verde-principale);
                width: 100%;
                flex-shrink: 0;
            }

            /* Card centrale di autenticazione */
            .login-card {
                width: 100%;
                max-width: 460px;
                padding: 32px;
                background-color: #ffffff;
                border: 1px solid var(--bordo-card);
                border-top: 4px solid var(--verde-principale);
                border-radius: 10px;
                box-shadow: 0 6px 20px rgba(8, 76, 50, 0.08);
            }

            .login-title {
                text-align: center;
                margin-bottom: 24px;
            }

                .login-title h3 {
                    color: var(--verde-scuro);
                    font-weight: 700;
                    margin-bottom: 4px;
                }

            .form-label {
                font-weight: 600;
                color: #1b2a22;
            }

            /* Focus dei campi allineato al verde principale */
            .form-control:focus {
                border-color: var(--verde-principale);
                box-shadow: 0 0 0 0.2rem rgba(14, 107, 71, 0.18);
            }

            /* Pulsante primario di accesso */
            .btn-login {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
                color: #ffffff;
                font-weight: 600;
                padding: 10px 16px;
            }

                .btn-login:hover,
                .btn-login:focus {
                    background-color: var(--verde-scuro);
                    border-color: var(--verde-scuro);
                    color: #ffffff;
                }
    </style>
</head>
<body class="login-page">
    <div class="top-accent-bar" aria-hidden="true"></div>

    <!-- flex-grow-1 occupa lo spazio residuo tra barra superiore e bordo inferiore -->
    <main class="d-flex flex-column flex-grow-1 justify-content-center align-items-center px-3 py-4">

        <div class="login-card">
            <div class="login-title">
                <h3>Gestione Eventi Magazzino</h3>
                <p class="text-muted mb-0">Accedi al sistema</p>
            </div>

            <form asp-controller="Login" asp-action="Index" method="post">

                <!-- Conserva l'URL originale in caso di reindirizzamento da risorsa protetta -->
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Mostra eventuali errori generali di autenticazione (es. credenziali non valide) -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username"
                           class="form-control"
                           autocomplete="username"
                           autofocus />
                    <span asp-validation-for="Username"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-login w-100">
                    Accedi
                </button>

            </form>
        </div>

        <footer class="text-center mt-4">
            <img src="~/images/sfondoJRgreen.jpeg"
                 alt="Logo JUNIORSOFT"
                 class="img-fluid"
                 style="max-width: 260px; height: auto;" />
        </footer>

    </main>

    <!-- Ordine obbligatorio per la validazione lato client: jQuery -> Validate -> Unobtrusive -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>