@model GestionEventiMagazzino.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Crea utente";
    Layout = null; // Pagina autonoma senza header e footer del layout principale
}

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crea utente - Gestione Eventi Magazzino</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            /* Palette verde e bianco ispirata alla barra superiore e al bordo inferiore del riferimento */
            :root {
                --verde-principale: #0e6b47;
                --verde-scuro: #084c32;
                --verde-sfondo: #eaf2ec;
                --bordo-card: #cfe0d5;
                --verde-bordo-basso: #6ca83b;
            }

            /* Imposta la struttura a colonna per tenere il contenuto principale sopra il footer */
            body.admin-page {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                margin: 0;
                background-color: var(--verde-sfondo);
                border-bottom: 8px solid var(--verde-bordo-basso);
            }

            /* Fascia superiore verde in stile barra di navigazione */
            .top-header-bar {
                background-color: var(--verde-principale);
                color: #ffffff;
                padding: 0.75rem 1.5rem;
                border-bottom: 3px solid var(--verde-scuro);
            }

            .top-header-title {
                font-size: 1rem;
                font-weight: 700;
                letter-spacing: 0.3px;
                margin: 0;
            }

            .page-main {
                flex: 1 0 auto;
            }

            /* Card chiara con accento verde per il form di creazione utente */
            .user-form-card {
                background-color: #ffffff;
                border: 1px solid var(--bordo-card);
                border-top: 4px solid var(--verde-principale);
                border-radius: 10px;
                box-shadow: 0 6px 20px rgba(8, 76, 50, 0.08);
            }

            .form-heading {
                color: var(--verde-scuro);
                font-weight: 700;
            }

            .form-control:focus,
            .form-check-input:focus {
                border-color: var(--verde-principale);
                box-shadow: 0 0 0 0.2rem rgba(14, 107, 71, 0.18);
            }

            .form-check-input:checked {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
            }

            .btn-submit-green {
                background-color: var(--verde-principale);
                border-color: var(--verde-principale);
                color: #ffffff;
                font-weight: 600;
            }

                .btn-submit-green:hover,
                .btn-submit-green:focus {
                    background-color: var(--verde-scuro);
                    border-color: var(--verde-scuro);
                    color: #ffffff;
                }
    </style>
</head>
<body class="admin-page">

    <!-- Barra superiore verde coerente con il design di riferimento -->
    <header class="top-header-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="top-header-title">Gestione Eventi Magazzino — Amministrazione</span>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-light">
                Pannello admin
            </a>
        </div>
    </header>

    <main class="page-main container my-4 my-md-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card user-form-card">
                    <div class="card-body p-4">

                        <h2 class="form-heading mb-4 text-center">Creazione nuovo utente</h2>

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <!-- Form principale per la creazione dell'utente -->
                        <form asp-controller="Users"
                              asp-action="Create"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <label asp-for="Username" class="form-label"></label>
                                    <input asp-for="Username" class="form-control" />
                                    <span asp-validation-for="Username"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-sm-6 mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" />
                                    <span asp-validation-for="Email"
                                          class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-6 mb-3">
                                    <label asp-for="Password" class="form-label"></label>
                                    <input asp-for="Password" type="password" class="form-control" />
                                    <span asp-validation-for="Password"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-sm-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">
                                        Conferma password
                                    </label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Note" class="form-label"></label>
                                <textarea asp-for="Note"
                                          class="form-control"
                                          rows="3"></textarea>
                                <span asp-validation-for="Note"
                                      class="text-danger"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="IsAdmin" class="form-check-input" />
                                <label asp-for="IsAdmin" class="form-check-label">
                                    Amministratore
                                </label>
                            </div>

                            <button type="submit" class="btn btn-submit-green w-100 py-2">
                                Crea utente
                            </button>

                        </form>
                        <!-- Fine form principale -->
                        <!-- Azioni secondarie: navigazione verso dashboard e uscita dalla sessione -->
                        <div class="d-flex justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Vai alla dashboard
                            </a>

                            <!-- Form per il Logout in POST -->
                            <form asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="btn btn-outline-danger">
                                    Logout
                                </button>
                            </form>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Logo JUNIORSOFT posizionato in fondo alla pagina -->
    <footer class="text-center pb-3 mt-4">
        <img src="~/images/sfondoJRgreen.jpeg"
             alt="Logo JUNIORSOFT"
             class="img-fluid"
             style="max-width: 260px; height: auto;" />
    </footer>

    <!-- Ordine richiesto: jQuery -> jQuery Validate -> Unobtrusive Validation -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>